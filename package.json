{
  "name": "multichat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:types && vite build",
    "build:types": "vue-tsc --project tsconfig.build.json --emitDeclarationOnly",
    "preview": "vite preview",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/types/vue/index.d.ts",
      "import": "./dist/vue.js"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/core.js"
    }
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
